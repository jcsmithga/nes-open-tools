{
  "about": "A standard par 72 whose back nine is predicted at least two strokes harder than its front.",
  "constraints": [
    {
      "rule": "standard",
      "par": 72
    },
    {
      "rule": "compare",
      "of": {
        "sum": "over_par"
      },
      "left": "back",
      "right": "front",
      "min": 2
    },
    {
      "rule": "expert_cap",
      "per_nine": 1
    }
  ]
}
