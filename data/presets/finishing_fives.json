    {
      "rule": "standard",
      "par": 72
    },
    {
      "rule": "slot",
      "hole": [
        9,
        18
      ],
      "where": {
        "par": 5
      }
    },
    {
      "rule": "exclude",
      "where": {
        "par": 5
      },
      "scope": [
        1
      ]
    },
    {
      "rule": "expert_cap",
      "per_nine": 1
    }
  ]
}
